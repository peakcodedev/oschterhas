{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": false,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*",
  "RateLimits": {
    "MarkFoundPerMinute": 30,
    "EventStreamsPerClient": 50
  },
  "Hosting": {
    "BaseDomain": "oschterhas.li",
    "AdminSubdomain": "admin"
  },
  "Oidc": {
    "Authority": "",
    "ClientId": "oschterhas-bff"
  },
  "IdentityAdmin": {
    "BaseUrl": "",
    "Realm": "oschterhas",
    "ClientId": "oschterhas-user-admin",
    "InvitationClientId": "oschterhas-bff",
    "InvitationRedirectUri": ""
  },
  "Auth": {
    "InitialPlatformAdmins": []
  },
  "CustomDomains": {
    "DnsTarget": "custom.oschterhas.li"
  },
  "InternalNetwork": {
    "AllowedNetworks": [
      "127.0.0.0/8",
      "::1/128"
    ]
  },
  "ReverseProxy": {
    "TrustedNetworks": [],
    "DataProtectionKeysDirectory": null
  }
}
