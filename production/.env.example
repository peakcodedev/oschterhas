# Production configuration. Create production/.env on the server from this file (by hand, once);
# the deployment never overwrites it. Never commit the real values.

# Base domain: instances at <slug>.<domain>, administration at admin.<domain>.
# DNS: <domain>, *.<domain> and custom.<domain> point to the server.
OSCHTERHAS_BASE_DOMAIN=oschterhas.li

# Central Peakcode Identity (identity_peakcode/production, KEYCLOAK_HOSTNAME there).
# Issuer: https://<hostname>/realms/oschterhas. Changing it breaks the issuer + subject user mapping.
KEYCLOAK_HOSTNAME=auth.example.ch
# Same values as OSCHTERHAS_OIDC_CLIENT_SECRET / OSCHTERHAS_USER_ADMIN_CLIENT_SECRET in identity's production/.env
OSCHTERHAS_OIDC_CLIENT_SECRET=change-me
OSCHTERHAS_USER_ADMIN_CLIENT_SECRET=change-me

# Keycloak user id of the first platform admin (only used while Oschterhas has no users yet).
OSCHTERHAS_INITIAL_PLATFORM_ADMIN=

# Target for the CNAME of custom domains (default custom.<domain>).
#OSCHTERHAS_CUSTOM_DOMAIN_TARGET=custom.oschterhas.li

# Database: schema owner (migrations) and the login of the running app (read/write only).
POSTGRES_PASSWORD=change-me
POSTGRES_APP_PASSWORD=change-me
